# AgroCloud full-stack on Hostinger VPS (single domain — no api. subdomain).
#
# Prerequisites on VPS (2.24.11.216):
#   - Node app :3001 (systemd agrocloud-node) serves SPA + /api/*
#   - agri-field-boundary :8092 (localhost only)
#   - Optional ftw-inference-api :8000 (Custom inference — Global FTW uses client PMTiles, no backend)
#
# DNS (Hostinger): A @ and A www → VPS IP. Keep MX records for email unchanged.
# TLS: certbot --nginx -d eliteagrocloud.com -d www.eliteagrocloud.com
#
# Install:
#   sudo cp scripts/nginx-eliteagrocloud-vps.conf.example /etc/nginx/sites-available/eliteagrocloud.com
#   sudo ln -sf /etc/nginx/sites-available/eliteagrocloud.com /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx

upstream agrocloud_node {
  server 127.0.0.1:3001;
  keepalive 64;
}

# Optional — FTW Custom inference API (not required for Global PMTiles overlay)
upstream ftw_inference_api {
  server 127.0.0.1:8000;
  keepalive 16;
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name eliteagrocloud.com www.eliteagrocloud.com;

  ssl_certificate     /etc/letsencrypt/live/eliteagrocloud.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/eliteagrocloud.com/privkey.pem;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  client_max_body_size 64m;

  gzip on;
  gzip_vary on;
  gzip_types text/css application/javascript application/json image/svg+xml font/woff2;
  gzip_min_length 1024;

  # FTW Custom inference (optional future mode)
  location /api/ftw/ {
    proxy_pass http://ftw_inference_api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 600s;
  }

  # Node Express — SPA static + /api/* proxies
  location / {
    proxy_pass http://agrocloud_node;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 300s;
  }
}

server {
  listen 80;
  listen [::]:80;
  server_name eliteagrocloud.com www.eliteagrocloud.com;
  return 301 https://$host$request_uri;
}
