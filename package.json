{
  "name": "agri-cloud",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Agri Cloud \u2014 npm workspaces (frontend + backend)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "main": "server.js",
  "scripts": {
    "dev": "node scripts/print-dev-urls.mjs && concurrently -n frontend,backend \"npm run dev -w frontend\" \"npm run dev -w backend\"",
    "dev:clean": "node scripts/print-dev-urls.mjs && concurrently -n frontend,backend \"npm run dev:client:clean -w frontend\" \"npm run dev -w backend\"",
    "dev:urls": "node scripts/print-dev-urls.mjs",
    "dev:client": "npm run dev -w frontend",
    "dev:server": "npm run dev -w backend",
    "dev:server:clean": "node frontend/scripts/free-port.mjs 3011 && npm run dev -w backend",
    "dev:client:clean": "npm run dev:client:clean -w frontend",
    "start": "node server.js",
    "build": "node scripts/build-hostinger.mjs",
    "build:production": "node scripts/build-production.mjs",
    "deploy:hostinger": "node scripts/deploy-hostinger-archive.mjs",
    "upload:hostinger": "node scripts/upload-hostinger.mjs",
    "test:smtp": "node scripts/test-smtp.mjs",
    "pages:publish": "node scripts/pages-dist-check.mjs && node scripts/publish-pages-docs.mjs",
    "preview": "npm run preview -w frontend",
    "typecheck": "npm run typecheck -w frontend && npm run typecheck:strict -w frontend",
    "lint": "eslint .",
    "test": "npm run test -w frontend && npm run test -w backend",
    "test:e2e": "npm run test:e2e -w frontend"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "vite": {
      "rollup": "4.60.0"
    }
  }
}
