# Production template — copy to `.env.production` on the server or Hostinger panel.
# NEVER commit real values. Real secrets belong in the hosting env / `.env.production` (gitignored).

AgroCloud_ENV=production
NODE_ENV=production
HOST=0.0.0.0
# Do NOT set PORT on Hostinger — the panel injects the proxy port automatically.

# Primary public URL (SPA on GitHub Pages; API on Hostinger)
APP_ORIGIN=https://www.eliteagrocloud.com
VITE_BASE_PATH=/
VITE_APP_CANONICAL_URL=https://www.eliteagrocloud.com
# SPA origins that may call this Hostinger Node API (api.eliteagrocloud.com)
CORS_ALLOWED_ORIGINS=https://www.eliteagrocloud.com,https://eliteagrocloud.com,https://api.eliteagrocloud.com,https://alkamelgis.github.io,https://elite.geosyntra.org
# Pages builds should also set (repo Variable or code fallback):
# VITE_AGRI_API_SECRETS_URL=https://api.eliteagrocloud.com/api/system/api-secrets

# Enterprise security (optional overrides)
# FORCE_HTTPS=true
# CSP_REPORT_URI=
# CSP_CONNECT_SRC_EXTRA=

# Persistent data directory (outside web root on VPS / shared hosting)
AGRI_DATA_DIR=/data/agrocloud
# Derived automatically when AGRI_DATA_DIR is set:
#   agri_api_secrets.json, agri_admin_directory.json, agri_user_profiles.json

# Protect /api/system/api-secrets (defaults to JWT_SECRET in production when unset)
JWT_SECRET=generate-a-long-random-string
AGRI_API_VAULT_MASTER_KEY=optional-second-secret-for-future-vault-encryption

# --- Auth / email verification (required for signup confirmation emails) ---
AUTH_REQUIRE_EMAIL_VERIFICATION=true
AUTH_REQUIRE_ADMIN_APPROVAL=true
AUTH_ADMIN_NOTIFY_EMAIL=admin@eliteagrocloud.com

# SMTP — Hostinger panel: smtp.hostinger.com port 465 SSL
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@eliteagrocloud.com
SMTP_PASS=
SMTP_FROM=Agro Cloud <admin@eliteagrocloud.com>

# --- AI (server /api/ai/chat) ---
GEMINI_API_KEY=
OPENAI=
OPENAI_API_KEY=
DEEPSEEK=
DEEPSEEK_API_KEY=

# --- Geospatial / weather (server bootstraps agri_api_secrets.json; VITE_* set at build) ---
MAPBOX_TOKEN=
OPENROUTESERVICE=
SENTINEL_HUB_ACCESS_TOKEN=PUBLIC_DATA_FEATURED_COLLECTIONS
SENTINEL_HUB_WMS_INSTANCE_ID=60de79ca-16a7-4afd-bcbd-0261bf0156fa
OPENWEATHERMAP_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=

# PWA
ENABLE_PWA=true
VITE_ENABLE_PWA=true

# Optional: GitHub Pages SPA calling this API for token sync
# VITE_AGRI_API_SECRETS_URL=https://api.your-domain.com/api/system/api-secrets
# VITE_AGRI_API_SECRETS_TOKEN=same-as-JWT_SECRET

# Deploy on Hostinger:
#   npm run deploy:hostinger
#   Upload hostinger-deploy.zip via Hostinger Node.js deploy
