# Production template — copy to `.env.production` on the server or Hostinger panel.
# NEVER commit real values. Real secrets belong in the hosting env / `.env.production` (gitignored).

AgroCloud_ENV=production
NODE_ENV=production
HOST=0.0.0.0
# Do NOT set PORT on Hostinger — the panel injects the proxy port automatically.

# Primary public URL. Node API + SPA on https://eliteagrocloud.com (Hostinger full-stack).
APP_ORIGIN=https://www.eliteagrocloud.com
VITE_BASE_PATH=/
VITE_APP_CANONICAL_URL=https://www.eliteagrocloud.com
CORS_ALLOWED_ORIGINS=https://www.eliteagrocloud.com,https://eliteagrocloud.com,https://api.eliteagrocloud.com,https://alkamelgis.github.io
# Empty on Hostinger full-stack (same-origin /api). GitHub Pages builds use eliteagrocloud.com.
VITE_AGRI_API_SECRETS_URL=https://eliteagrocloud.com
AI_LOCAL_AUTOSTART=0
# Hostinger shared Node cannot bind Python :8092 / :8080. Leave these pointing at localhost;
# the API falls back to in-process RGB detect when Python is unreachable.
# Optional: run the Python services on a VPS and set these to http://VPS_IP:port/...
# Point Hostinger Node at the VPS Python field engine (required for FTW live / FoW / SEN2SR).
# Without this, Detect Fields still works via Map RGB (spectral-builtin) on eliteagrocloud.com.
# Hostinger VPS (FTW live / FoW / SEN2SR) — set after bootstrap on the VPS:
FIELD_BOUNDARY_URL=http://2.24.11.216:8092/detect
# Local fallback when VPS is down (dev only):
# FIELD_BOUNDARY_URL=http://127.0.0.1:8092/detect
TREE_DETECTION_URL=http://127.0.0.1:8080/predict
# SegFormer / Training AI. Hostinger cannot bind Python :8095; leave default localhost
# and the API uses in-process spectral training when Python is unreachable.
# Optional GPU box: SEGFORMER_DETECTION_URL=https://<your-service>
SEGFORMER_DETECTION_URL=http://127.0.0.1:8095

# Enterprise security (optional overrides)
# FORCE_HTTPS=true
# CSP_REPORT_URI=
# CSP_CONNECT_SRC_EXTRA=

# Persistent data directory (outside web root on VPS / shared hosting)
AGRI_DATA_DIR=/data/agrocloud
# Derived automatically when AGRI_DATA_DIR is set:
#   agri_api_secrets.json, agri_admin_directory.json, agri_user_profiles.json

# Protect /api/system/api-secrets (defaults to JWT_SECRET in production when unset)
JWT_SECRET=generate-a-long-random-string
AGRI_API_VAULT_MASTER_KEY=optional-second-secret-for-future-vault-encryption

# --- Auth / email verification (required for signup confirmation emails) ---
AUTH_REQUIRE_EMAIL_VERIFICATION=true
AUTH_REQUIRE_ADMIN_APPROVAL=true
AUTH_ADMIN_NOTIFY_EMAIL=admin@eliteagrocloud.com

# SMTP — Hostinger panel: smtp.hostinger.com port 465 SSL
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@eliteagrocloud.com
SMTP_PASS=
SMTP_FROM=Agro Cloud <admin@eliteagrocloud.com>

# --- AI (server /api/ai/chat) ---
GEMINI_API_KEY=
OPENAI=
OPENAI_API_KEY=
DEEPSEEK=
DEEPSEEK_API_KEY=

# --- Geospatial / weather (server bootstraps agri_api_secrets.json; VITE_* set at build) ---
MAPBOX_TOKEN=
OPENROUTESERVICE=
SENTINEL_HUB_ACCESS_TOKEN=PUBLIC_DATA_FEATURED_COLLECTIONS
SENTINEL_HUB_WMS_INSTANCE_ID=60de79ca-16a7-4afd-bcbd-0261bf0156fa
OPENWEATHERMAP_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=

# PWA
ENABLE_PWA=true
VITE_ENABLE_PWA=true

# GitHub Pages SPA → Hostinger Node (already set above as VITE_AGRI_API_SECRETS_URL)
# VITE_AGRI_API_SECRETS_TOKEN=same-as-JWT_SECRET

# Deploy on Hostinger:
#   npm run deploy:hostinger
#   Upload hostinger-deploy.zip via Hostinger Node.js deploy
