# =============================================================================
# AgroCloud — environment template (safe to commit)
# Copy to `.env` at repo root and fill values. NEVER commit `.env` (see .gitignore).
#
# If a key was ever pushed to GitHub, rotate it at the provider immediately.
# See SECURITY.md and docs/GIT_HISTORY_SECRET_CLEANUP.md.
#
# Deployment (Hostinger / AWS / Docker):
#   - Set the same variables in the hosting panel or CI secrets.
#   - Frontend build needs VITE_* variables at `npm run build` time.
#   - Node API reads unprefixed keys at runtime (OPENAI_API_KEY, etc.).
# =============================================================================

# --- App / server ---
NODE_ENV=development
AgroCloud_ENV=development
HOST=0.0.0.0
# Local dev only — Geosyntra uses 3001/3002; AgroCloud uses 3011/3012.
PORT=3011
WS_PORT=3012
VITE_DEV_PORT=5174
# APP_ORIGIN=http://localhost:5174/AgroCloud
# CORS_ALLOWED_ORIGINS=https://your-domain.com,https://alkamelgis.github.io

# Persistent data (production VPS — sets secrets + admin + profile JSON paths)
# AGRI_DATA_DIR=/data/agrocloud
# JWT_SECRET=
# AGRI_API_VAULT_MASTER_KEY=

# --- AI providers (server + optional VITE_* for browser build) ---
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

OPENAI_API_KEY=
OPENAI=
VITE_OPENAI_API_KEY=

DEEPSEEK_API_KEY=
VITE_DEEPSEEK_API_KEY=

# --- Geospatial / weather ---
OPENROUTESERVICE=
VITE_OPENROUTESERVICE=

SENTINEL_HUB_ACCESS_TOKEN=
VITE_SENTINEL_HUB_ACCESS_TOKEN=
# OAuth client for Sentinel Hub Statistical / Process API.
# Layer Live WMS: PUBLIC_DATA_FEATURED_COLLECTIONS + SENTINEL_HUB_WMS_INSTANCE_ID also enable AOI statistics
# (server computes zonal means via WMS + evalscript — no extra OAuth required).
# Optional — faster Statistical API via OAuth (free at https://dataspace.copernicus.eu/ → User Settings → OAuth clients):
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
VITE_CDSE_CLIENT_ID=
VITE_CDSE_CLIENT_SECRET=
# Optional — Sentinel Hub commercial OAuth: https://apps.sentinel-hub.com/
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
VITE_SENTINEL_HUB_CLIENT_ID=
VITE_SENTINEL_HUB_CLIENT_SECRET=

SENTINEL_HUB_WMS_INSTANCE_ID=
VITE_SENTINEL_HUB_WMS_INSTANCE_ID=
# Optional — CDSE Configuration Utility instance for ESA Sentinel Layer Live
# (https://sh.dataspace.copernicus.eu → Configuration Utility). When unset, ESA uses Sentinel Hub open data.
CDSE_WMS_INSTANCE_ID=
VITE_CDSE_WMS_INSTANCE_ID=

OPENWEATHERMAP_API_KEY=
VITE_OPENWEATHER_API_KEY=

GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_SERVER_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Cloud GIS uploads (Add GIS Layer → Upload; optional)
# Google: OAuth 2.0 Web client ID + enable Drive API. API key optional (falls back to Maps key).
VITE_GOOGLE_DRIVE_CLIENT_ID=
VITE_GOOGLE_DRIVE_API_KEY=
# Dropbox: app key with Chooser + your site domain in Dropbox console.
VITE_DROPBOX_APP_KEY=
# Microsoft: Azure app registration (OneDrive picker).
VITE_ONEDRIVE_CLIENT_ID=

# Mapbox basemaps removed — leave empty unless legacy geocoding override is needed.
VITE_MAPBOX_TOKEN=
VITE_MAPBOX_ACCESS_TOKEN=

# ArcGIS Portal / REST token — required to load secured ArcGIS feature layers
# (e.g. private "portal items"). On a Node deploy set ARCGIS_PORTAL_TOKEN (the
# server seeds it into api-secrets and mirrors VITE_ARCGIS_PORTAL_TOKEN for the
# build). For a purely static build, set VITE_ARCGIS_PORTAL_TOKEN directly.
# ARCGIS_PORTAL_TOKEN=
VITE_ARCGIS_PORTAL_TOKEN=

# --- PWA ---
VITE_ENABLE_PWA=true

# --- Optional: persist API keys on Node server (recommended for production) ---
# AGRI_API_SECRETS_FILE=/data/agri_api_secrets.json
# AGRI_API_SECRETS_TOKEN=
# VITE_AGRI_API_SECRETS_TOKEN=

# --- Tree Detection (Ultralytics YOLO Detection, class: tree) ---
# Esri mosaic → YOLO boxes → GIS Point (Tree_ID, X, Y, Confidence, Date, Image_Source).
# Start backend/services/tree-detection (start-local.ps1 or docker compose up).
# If YOLO is down, Node falls back to in-process canopy detect (same /predict JSON).
# TREE_DETECTION_URL=http://127.0.0.1:8080/predict
# Hosted:
# TREE_DETECTION_URL=https://<your-railway-domain>/predict
# TREE_DETECTION_TOKEN=
# TREE_DETECTION_FILE_FIELD=file
# TREE_DETECTION_MODEL=
# TREE_DETECTION_IMG_SIZE=640
# TREE_DETECTION_IOU=0.45
# TREE_DETECTION_CONF=0.25

# --- AI SAM Detection (Segment Anything) ---
# Interactive Segment Anything Model segmentation endpoint. A ready-to-run,
# ZERO-CONFIG service ships in backend/services/sam-detection/ (segment-geospatial
# / samgeo — it auto-downloads the SAM checkpoint). Start it with `docker compose
# up` there and the backend uses it automatically — the default below already
# points at it, so for LOCAL use you do NOT need to set SAM_DETECTION_URL at all.
# Only set it to point at a REMOTE/hosted GPU service (e.g. in production).
# Request: { image, bbox:[w,s,e,n], points:[{x,y,label}] } → GeoJSON polygons + mask.
# Local default (bundled service via docker compose) — no need to set this:
# SAM_DETECTION_URL=http://127.0.0.1:8090/segment
# Hosted (KEEP the /segment suffix):
# SAM_DETECTION_URL=https://<your-host-domain>/segment
# SAM_DETECTION_TOKEN=

# --- SegFormer / Training AI ---
# Python service: backend/services/segformer-detection/ (port 8095).
# Production Hostinger uses in-process spectral training when this is down.
# SEGFORMER_DETECTION_URL=http://127.0.0.1:8095
# Hosted GPU:
# SEGFORMER_DETECTION_URL=https://<your-service>
# SEGFORMER_DETECTION_TOKEN=

# --- Agri Field Boundary Detection (Mask R-CNN) ---
# OpenGeoAI-style instance segmentation for agricultural parcels.
# Service: backend/services/agri-field-boundary/ (port 8092).
# Optional trained weights: FIELD_BOUNDARY_MODEL_PATH=/path/to/best_model.pth
# Delineate-Anything auto-downloads weights on first run (default ML for RGB).
# Local default — no need to set for local uvicorn:
# FIELD_BOUNDARY_URL=http://127.0.0.1:8092/detect
# FIELD_BOUNDARY_TOKEN=

# --- Image Classification Wizard (ML service) ---
# FastAPI service for supervised/unsupervised land-cover classification. A service
# ships in backend/services/image-classification/ (rasterio + scikit-learn +
# scikit-image). Start it with `docker compose up` and the backend uses it
# automatically — the default below already points at it, so for LOCAL use you do
# NOT need to set IMAGE_CLASSIFICATION_URL at all.
# Local default (bundled service via docker compose): http://image-classification:8000
# Local dev (running uvicorn directly): http://127.0.0.1:8000
# IMAGE_CLASSIFICATION_URL=http://127.0.0.1:8000

# --- GeoAI Chat (conversational GIS, port 8099) ---
# FastAPI service: backend/services/geoai-chat/
# Local: cd backend/services/geoai-chat && uvicorn app:app --reload --port 8099
# Health via Node proxy: GET http://localhost:3011/api/geoai-chat/health
GEOAI_CHAT_URL=http://127.0.0.1:8099
# GEOAI_CHAT_TOKEN=
# OPENAI_API_KEY=   # server-side only for GeoAI Chat LLM explanations (never VITE_*)

# --- Auth / SMTP (local backend email verification) ---
# AUTH_REQUIRE_EMAIL_VERIFICATION=true
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Agro Cloud <noreply@localhost>
