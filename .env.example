# =============================================================================
# AgroCloud — environment template (safe to commit)
# Copy to `.env` at repo root and fill values. NEVER commit `.env` (see .gitignore).
#
# If a key was ever pushed to GitHub, rotate it at the provider immediately.
# See SECURITY.md and docs/GIT_HISTORY_SECRET_CLEANUP.md.
#
# Deployment (Hostinger / AWS / Docker):
#   - Set the same variables in the hosting panel or CI secrets.
#   - Frontend build needs VITE_* variables at `npm run build` time.
#   - Node API reads unprefixed keys at runtime (OPENAI_API_KEY, etc.).
# =============================================================================

# --- App / server ---
NODE_ENV=development
AgroCloud_ENV=development
HOST=0.0.0.0
# Local dev only — Geosyntra uses 3001/3002; AgroCloud uses 3011/3012.
PORT=3011
WS_PORT=3012
VITE_DEV_PORT=5174
# APP_ORIGIN=http://localhost:5174/AgroCloud
# CORS_ALLOWED_ORIGINS=https://your-domain.com,https://alkamelgis.github.io

# Persistent data (production VPS — sets secrets + admin + profile JSON paths)
# AGRI_DATA_DIR=/data/agrocloud
# JWT_SECRET=
# AGRI_API_VAULT_MASTER_KEY=

# --- AI providers (server + optional VITE_* for browser build) ---
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

OPENAI_API_KEY=
OPENAI=
VITE_OPENAI_API_KEY=

DEEPSEEK_API_KEY=
VITE_DEEPSEEK_API_KEY=

# --- Geospatial / weather ---
OPENROUTESERVICE=
VITE_OPENROUTESERVICE=

SENTINEL_HUB_ACCESS_TOKEN=
VITE_SENTINEL_HUB_ACCESS_TOKEN=
# OAuth client for Sentinel Hub Statistical / Process API.
# Layer Live WMS: PUBLIC_DATA_FEATURED_COLLECTIONS + SENTINEL_HUB_WMS_INSTANCE_ID also enable AOI statistics
# (server computes zonal means via WMS + evalscript — no extra OAuth required).
# Optional — faster Statistical API via OAuth (free at https://dataspace.copernicus.eu/ → User Settings → OAuth clients):
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
VITE_CDSE_CLIENT_ID=
VITE_CDSE_CLIENT_SECRET=
# Optional — Sentinel Hub commercial OAuth: https://apps.sentinel-hub.com/
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
VITE_SENTINEL_HUB_CLIENT_ID=
VITE_SENTINEL_HUB_CLIENT_SECRET=

SENTINEL_HUB_WMS_INSTANCE_ID=
VITE_SENTINEL_HUB_WMS_INSTANCE_ID=

OPENWEATHERMAP_API_KEY=
VITE_OPENWEATHER_API_KEY=

GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_SERVER_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Cloud GIS uploads (Add GIS Layer → Upload; optional)
# Google: OAuth 2.0 Web client ID + enable Drive API. API key optional (falls back to Maps key).
VITE_GOOGLE_DRIVE_CLIENT_ID=
VITE_GOOGLE_DRIVE_API_KEY=
# Dropbox: app key with Chooser + your site domain in Dropbox console.
VITE_DROPBOX_APP_KEY=
# Microsoft: Azure app registration (OneDrive picker).
VITE_ONEDRIVE_CLIENT_ID=

# Mapbox basemaps removed — leave empty unless legacy geocoding override is needed.
VITE_MAPBOX_TOKEN=
VITE_MAPBOX_ACCESS_TOKEN=

# ArcGIS Portal / REST token — required to load secured ArcGIS feature layers
# (e.g. private "portal items"). On a Node deploy set ARCGIS_PORTAL_TOKEN (the
# server seeds it into api-secrets and mirrors VITE_ARCGIS_PORTAL_TOKEN for the
# build). For a purely static build, set VITE_ARCGIS_PORTAL_TOKEN directly.
# ARCGIS_PORTAL_TOKEN=
VITE_ARCGIS_PORTAL_TOKEN=

# --- PWA ---
VITE_ENABLE_PWA=true

# --- Optional: persist API keys on Node server (recommended for production) ---
# AGRI_API_SECRETS_FILE=/data/agri_api_secrets.json
# AGRI_API_SECRETS_TOKEN=
# VITE_AGRI_API_SECRETS_TOKEN=

# --- Tree Detection ---
# Tree-crown inference endpoint. A ready-to-run, ZERO-CONFIG service ships in
# backend/services/tree-detection/ (DeepForest by default — it auto-downloads a
# pretrained model; optional YOLO). Start it with `docker compose up` there and
# the backend uses it automatically — the default below already points at it, so
# for LOCAL use you do NOT need to set TREE_DETECTION_URL at all.
# Only set it to point at a REMOTE/hosted model service (e.g. in production).
# Expected response (tolerant): { "boxes": [ { x1, y1, x2, y2, confidence, name } ] }
# Local default (bundled service via docker compose) — no need to set this:
# TREE_DETECTION_URL=http://127.0.0.1:8080/predict
# Hosted on Railway (see backend/services/tree-detection/README → Deploy to
# Railway). Use your service's public domain and KEEP the /predict suffix:
# TREE_DETECTION_URL=https://<your-railway-domain>/predict
# TREE_DETECTION_TOKEN=
# TREE_DETECTION_FILE_FIELD=file
# TREE_DETECTION_MODEL=
# TREE_DETECTION_IMG_SIZE=640
# TREE_DETECTION_IOU=0.45
# TREE_DETECTION_CONF=0.25

# --- Auth / SMTP (local backend email verification) ---
# AUTH_REQUIRE_EMAIL_VERIFICATION=true
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Agro Cloud <noreply@localhost>
