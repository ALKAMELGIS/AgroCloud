# Enable MUI App Shell (AppBar, Drawer, mobile bottom navigation). Legacy shell when unset or false.
VITE_MUI_SHELL=false

# Mapbox basemaps (Develop Elite / GIS map picker). Use either variable name.
# Create a token at https://account.mapbox.com/ — scopes: styles:read, tiles:read
# VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token
# VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token

# Embedded Pages: route iframe through backend /api/embed/browse (bypasses X-Frame-Options). Requires Node API.
# VITE_EMBED_FORCE_PROXY=true
